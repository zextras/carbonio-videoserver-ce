[Unit]
Description=Carbonio Videoserver Sidecar
Documentation=https://docs.zextras.com/
Requires=network-online.target
After=network-online.target

[Service]
User=videoserver
ExecStart=/usr/bin/consul connect envoy \
    -token-file /etc/carbonio/videoserver/service-discover/token \
    -admin-bind localhost:0 \
    -sidecar-for carbonio-videoserver
ExecReload=/usr/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=15s
KillSignal=SIGINT
LimitNOFILE=65536

# Hardening
PrivateTmp=yes
#ProtectSystem=strict
ProtectSystem=yes
NoNewPrivileges=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectHostname=yes
ProtectClock=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
